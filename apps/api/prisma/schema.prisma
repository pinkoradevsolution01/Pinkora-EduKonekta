  @@index([schoolId, evaluationId, createdAt])
  @@index([schoolId, editedByUserId, createdAt])
  @@map("evaluation_histories")
}

model Conversation {
  id            String            @id @default(uuid()) @db.Uuid
  schoolId      String            @map("school_id") @db.Uuid
  studentId     String            @map("student_id") @db.Uuid
  parentUserId  String            @map("parent_user_id") @db.Uuid
  teacherUserId String            @map("teacher_user_id") @db.Uuid
  state         ConversationState @default(ACTIVE)
  escalationReason String?        @map("escalation_reason") @db.Text
  escalatedByUserId String?       @map("escalated_by_user_id") @db.Uuid
  adminAccessedByUserId String?   @map("admin_accessed_by_user_id") @db.Uuid
  adminAccessedAt DateTime?       @map("admin_accessed_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent        User              @relation("ConversationParents", fields: [parentUserId], references: [id], onDelete: Restrict)
  teacher       User              @relation("ConversationTeachers", fields: [teacherUserId], references: [id], onDelete: Restrict)
  messages      Message[]
  @@index([schoolId, parentUserId, updatedAt])
  @@index([schoolId, teacherUserId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  authorUserId   String       @map("author_user_id") @db.Uuid
  content        String       @db.Text
  attachmentName String?      @map("attachment_name") @db.VarChar(255)
  attachmentMime String?      @map("attachment_mime") @db.VarChar(100)
  attachmentSize Int?         @map("attachment_size")
  attachmentStorageKey String? @map("attachment_storage_key") @db.VarChar(500)
  readAt         DateTime?    @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User         @relation("MessageAuthors", fields: [authorUserId], references: [id], onDelete: Restrict)
  @@index([schoolId, conversationId, createdAt])
  @@map("messages")
}

/// Explicit, school-scoped authorisation for confidential safeguarding access.
/// A GUIDANCE role alone is not enough to reveal protected reporter information.
model SafeguardingAccess {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@index([schoolId, isActive])
  @@map("safeguarding_accesses")
}

model SafetyReport {
  id                        String             @id @default(uuid()) @db.Uuid
  schoolId                  String             @map("school_id") @db.Uuid
  reporterUserId            String             @map("reporter_user_id") @db.Uuid
  category                  String             @db.VarChar(100)
  incidentDate              DateTime           @map("incident_date") @db.Date
  location                  String?            @db.VarChar(300)
  descriptionEncrypted      String             @map("description_encrypted") @db.Text
  protectedIdentityEncrypted String             @map("protected_identity_encrypted") @db.Text
  evidenceEncrypted         String?            @map("evidence_encrypted") @db.Text
  duplicateFingerprint      String             @map("duplicate_fingerprint") @db.VarChar(128)
  duplicateCandidateCount   Int                @default(0) @map("duplicate_candidate_count")
  abuseIndicator            Boolean            @default(false) @map("abuse_indicator")
  status                    SafetyReportStatus @default(SUBMITTED)
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  school                    School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reporter                  User               @relation("SafetyReporters", fields: [reporterUserId], references: [id], onDelete: Restrict)
  updates                   SafetyReportUpdate[]
  guidanceCases              GuidanceCase[]

  @@index([schoolId, status, createdAt])
  @@index([schoolId, reporterUserId, createdAt])
  @@index([schoolId, duplicateFingerprint])
  @@map("safety_reports")
}

model SafetyReportUpdate {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  reportId      String   @map("report_id") @db.Uuid
  status        SafetyReportStatus
  reporterNote  String?  @map("reporter_note") @db.VarChar(1000)
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  report        SafetyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdBy     User?    @relation("SafetyUpdateAuthors", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, reportId, createdAt])
  @@map("safety_report_updates")
}

model GuidanceCase {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  reportId String @map("report_id") @db.Uuid
  priority GuidanceCasePriority @default(MEDIUM)
  status GuidanceCaseStatus @default(OPEN)
  actionPlanEncrypted String? @map("action_plan_encrypted") @db.Text
  referralEncrypted String? @map("referral_encrypted") @db.Text
  followUpAt DateTime? @map("follow_up_at") @db.Timestamptz(3)
  closedAt DateTime? @map("closed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  report SafetyReport @relation(fields:[reportId],references:[id],onDelete:Restrict)
  assignments GuidanceCaseAssignment[]
  notes GuidanceCaseNote[]
  @@unique([schoolId, reportId])
  @@index([schoolId,status,priority])
  @@map("guidance_cases")
}
model GuidanceCaseAssignment {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  caseId String @map("case_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  elevated Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  case GuidanceCase @relation(fields:[caseId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([caseId,userId])
  @@index([schoolId,userId])
  @@map("guidance_case_assignments")
}
model GuidanceCaseNote {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  caseId String @map("case_id") @db.Uuid
  authorUserId String @map("author_user_id") @db.Uuid
  contentEncrypted String @map("content_encrypted") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  case GuidanceCase @relation(fields:[caseId],references:[id],onDelete:Cascade)
  author User @relation(fields:[authorUserId],references:[id],onDelete:Restrict)
  @@index([schoolId,caseId,createdAt])
  @@map("guidance_case_notes")
}

model NotificationPreference {
