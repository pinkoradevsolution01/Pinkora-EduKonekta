  acknowledgements EvaluationAcknowledgement[]
  history         EvaluationHistory[]

  @@index([schoolId, studentId, observedAt])
  @@index([schoolId, visibility, observedAt])
  @@index([schoolId, authorUserId, createdAt])
  @@map("evaluation_notes")
}

model EvaluationAcknowledgement {
  id           String         @id @default(uuid()) @db.Uuid
  evaluationId String         @map("evaluation_id") @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  acknowledgedAt DateTime     @default(now()) @map("acknowledged_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  evaluation   EvaluationNote @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, userId])
  @@index([userId, acknowledgedAt])
  @@map("evaluation_acknowledgements")
}

model EvaluationHistory {
  id             String               @id @default(uuid()) @db.Uuid
  schoolId       String               @map("school_id") @db.Uuid
  evaluationId   String               @map("evaluation_id") @db.Uuid
  editedByUserId String               @map("edited_by_user_id") @db.Uuid
