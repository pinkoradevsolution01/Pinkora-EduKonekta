NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://edukonekta:edukonekta@localhost:5432/edukonekta?schema=public
CORS_ORIGIN=http://localhost:3100
API_PREFIX=api
API_VERSION=v1
LOG_LEVEL=info
SAFETY_ENCRYPTION_KEY=replace-with-a-strong-unique-secret-in-production
# Prefer same-origin browser calls; Next.js rewrites /api/v1 to API_INTERNAL_URL.
NEXT_PUBLIC_API_URL=/api/v1
API_INTERNAL_URL=http://localhost:4000/api/v1
# Optional transactional email delivery. If either value is absent, local development uses a safe no-op adapter.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
